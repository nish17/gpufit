# Optional. Raises Hugging Face rate limits for scripts/fetch_models.py.
HF_TOKEN=

# Public site origin used for canonical URLs. Default: https://gpufit.tech
SITE_URL=https://gpufit.tech

# Required before real alert email is sent. Create these yourself; the app
# runs with a local file store when they are absent.
RESEND_API_KEY=
ALERT_FROM=GPUfit <alerts@gpufit.tech>
ALERT_TOKEN_SECRET=replace-with-a-long-random-string

# Cloudflare Turnstile. Site key is public. Secret key is a Worker secret.
# astro dev still accepts signups when the secret is empty.
# A production worker rejects signups when the secret is empty and logs the
# variable name only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare D1 binding name expected by the worker is DB.
# Create the database, put its id in wrangler.jsonc, then:
#   npx wrangler d1 execute gpufit --file=schema/subscribers.sql
