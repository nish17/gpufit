---
import VendorMark from "../components/VendorMark.astro";
import Base from "../layouts/Base.astro";
import { devices, devicePath } from "../lib/catalog";

const groups = [
  { id: "nvidia" as const, label: "NVIDIA", list: devices.filter((device) => device.vendor === "nvidia" && device.kind === "gpu") },
  { id: "amd" as const, label: "AMD", list: devices.filter((device) => device.vendor === "amd" && device.kind === "gpu") },
  { id: "intel" as const, label: "Intel", list: devices.filter((device) => device.vendor === "intel") },
  { id: "apple" as const, label: "Apple", list: devices.filter((device) => device.vendor === "apple") },
  { id: "chip" as const, label: "Unified memory and CPU", list: devices.filter((device) => device.kind === "cpu" || device.kind === "unified") },
];
const description = "GPUs, Apple silicon, and CPU profiles GPUfit can score. Each card links to the spec and the vendor page it came from.";
---

<Base title="Supported hardware · GPUfit" description={description} path="/devices/">
  <article class="wrap page-intro" style="max-width:none;">
    <p class="kicker">Hardware</p>
    <h1 class="serif">Devices in the catalog</h1>
    <p class="lede">{devices.length} machines. Pick one to see which models fit. Specs are hand-checked, with a source link on each device page.</p>
    {groups.map((group) => (
      <section>
        <div class="vendor-lockup">
          <VendorMark id={group.id} />
          <div>
            <h2 class:list={[{ "vendor-name": group.id === "apple" || group.id === "chip" }]}>{group.label}</h2>
            <p class="muted">{group.list.length} profiles</p>
          </div>
        </div>
        <div class="device-grid">
          {group.list.map((device) => (
            <a class="device-card" href={devicePath(device)}>
              <b>{device.name}</b>
              <span>{device.kind === "gpu" ? `${device.vramGb} GB` : device.memoryOptionsGb?.join(" / ") + " GB"} · {device.bandwidthGBps} GB/s</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </article>
</Base>
