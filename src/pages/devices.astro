---
import Base from "../layouts/Base.astro";
import { devices, devicePath } from "../lib/catalog";

const groups = [
  ["NVIDIA", devices.filter((device) => device.vendor === "nvidia" && device.kind === "gpu")],
  ["AMD", devices.filter((device) => device.vendor === "amd" && device.kind === "gpu")],
  ["Intel", devices.filter((device) => device.vendor === "intel")],
  ["Apple", devices.filter((device) => device.vendor === "apple")],
  ["Unified and CPU", devices.filter((device) => device.kind === "cpu" || device.kind === "unified")],
] as const;
const description = "GPUs, Apple silicon, and CPU profiles GPUfit can score. Each spec links to the vendor page it was taken from.";
---

<Base title="Supported hardware · GPUfit" description={description} path="/devices">
  <article class="wrap prose" style="padding:2rem 0 1rem;">
    <p class="kicker">Hardware</p>
    <h1>Devices in the catalog</h1>
    <p>{description}</p>
    {groups.map(([label, list]) => (
      <section>
        <h2>{label}</h2>
        <ul>
          {list.map((device) => (
            <li>
              <a href={devicePath(device)}>{device.name}</a>
              <span class="muted"> — {device.kind === "gpu" ? `${device.vramGb} GB` : device.memoryOptionsGb?.join("/") + " GB"}, {device.bandwidthGBps} GB/s</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </article>
</Base>
