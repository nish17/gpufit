---
interface Props {
  id: "nvidia" | "amd" | "intel" | "apple" | "chip";
}
const { id } = Astro.props;
---

<span class="vendor-glyph" aria-hidden="true">
  {id === "nvidia" && (
    <svg viewBox="0 0 36 36">
      <rect x="4" y="7" width="28" height="22" rx="4" fill="none" stroke="currentColor" stroke-width="1.6" />
      <circle cx="13" cy="18" r="4" fill="none" stroke="currentColor" stroke-width="1.4" />
      <circle cx="23" cy="18" r="4" fill="none" stroke="currentColor" stroke-width="1.4" />
    </svg>
  )}
  {id === "amd" && (
    <svg viewBox="0 0 36 36">
      <rect x="4" y="7" width="28" height="22" rx="4" fill="none" stroke="currentColor" stroke-width="1.6" />
      <circle cx="18" cy="18" r="6" fill="none" stroke="currentColor" stroke-width="1.4" />
      <circle cx="18" cy="18" r="1.5" fill="currentColor" />
    </svg>
  )}
  {id === "intel" && (
    <svg viewBox="0 0 36 36">
      <rect x="5" y="5" width="26" height="26" rx="4" fill="none" stroke="currentColor" stroke-width="1.6" />
      <path d="M12 18h12M18 12v12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    </svg>
  )}
  {id === "apple" && (
    <svg viewBox="0 0 36 36">
      <rect x="6" y="6" width="24" height="24" rx="7" fill="none" stroke="currentColor" stroke-width="1.6" />
      <rect x="13" y="13" width="10" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.4" />
    </svg>
  )}
  {id === "chip" && (
    <svg viewBox="0 0 36 36">
      <rect x="8" y="8" width="20" height="20" rx="3" fill="none" stroke="currentColor" stroke-width="1.6" />
      <rect x="14" y="14" width="8" height="8" rx="1" fill="currentColor" />
      <path d="M13 4.5v3.5M18 4.5v3.5M23 4.5v3.5M13 28v3.5M18 28v3.5M23 28v3.5M4.5 13h3.5M4.5 18h3.5M4.5 23h3.5M28 13h3.5M28 18h3.5M28 23h3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  )}
</span>
